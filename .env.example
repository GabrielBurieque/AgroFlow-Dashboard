# Copiá este archivo como ".env" (o ".env.local") en la raíz del frontend.
# Vite solo expone al navegador las variables que empiezan con VITE_.
# El dashboard muestra únicamente datos de AgroFlow API (no hay modo mock).

# URL vista desde el navegador. host.docker.internal es solo para n8n en Docker.
VITE_API_URL=http://localhost:5000

# Historial de conversaciones (propuesta AgroFlow#88, la API aún NO lo expone).
# Sin esta variable la sección Chatbot aparece como no disponible.
# http → GET /api/v1/conversations y /{id}/events
# VITE_CONVERSATIONS_SOURCE=http
# Opcional, si el historial vive en otra URL:
# VITE_CONVERSATIONS_API_URL=http://localhost:5000
